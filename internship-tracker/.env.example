# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Load with:  set -a && source .env && set +a && ./gradlew bootRun

# --- Database -------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/internship_tracker
DB_USERNAME=internship
DB_PASSWORD=change-me

# --- Gmail OAuth (read-only) ---------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials
# Create an OAuth client of type "Desktop app".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_USER_ID=me

# Optional. If set, the app runs headless and never opens a browser.
# If unset, the app performs the installed-app consent flow once and caches
# the refresh token under GMAIL_TOKEN_DIRECTORY.
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_DIRECTORY=./.gmail-tokens

# How far back the first poll reaches. Later polls resume from a stored cursor.
GMAIL_LOOKBACK_DAYS=90
